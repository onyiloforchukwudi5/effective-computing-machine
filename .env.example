DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailcrm
REDIS_URL=redis://localhost:6379
# 32 bytes, base64 or 64 hex chars:  openssl rand -base64 32
ENCRYPTION_KEY=
# Secret used to sign unsubscribe tokens (openssl rand -base64 32)
SIGNING_SECRET=
APP_URL=http://localhost:3000
# web | worker (Docker image)
SERVICE=web
SYNC_CONCURRENCY=3
SYNC_INTERVAL_MINUTES=10
# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Email verification
VERIFY_FROM=verify@example.com
VERIFY_HELO=mail.example.com
# AI (optional server key; users can save their own)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_CAP=200
AI_DAILY_TOKEN_CAP=400000
# Allow private-IP SMTP hosts (dev only)
ALLOW_PRIVATE_HOSTS=false
